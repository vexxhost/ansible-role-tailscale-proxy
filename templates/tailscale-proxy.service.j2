[Unit]
Description=Tailscale Proxy Service
# With a federated client ID the endpoints register with an ID token from
# the host's tailscaled.
After=network.target tailscaled.service

[Service]
Type=simple
EnvironmentFile=/etc/tailscale-proxy.env
ExecStart=/usr/local/bin/tailscale-proxy -config /etc/tailscale-proxy.yaml
Restart=on-failure

[Install]
WantedBy=multi-user.target
