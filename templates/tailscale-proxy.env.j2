{% if tailscale_proxy_tailnet is defined %}
TS_TAILNET={{ tailscale_proxy_tailnet }}
{% endif %}
{% if tailscale_proxy_oauth_client_id is defined %}
TS_OAUTH_CLIENT_ID={{ tailscale_proxy_oauth_client_id }}
{% endif %}
{% if tailscale_proxy_oauth_client_secret is defined %}
TS_OAUTH_CLIENT_SECRET={{ tailscale_proxy_oauth_client_secret }}
{% endif %}
{% if tailscale_proxy_authkey is defined %}
TS_AUTHKEY={{ tailscale_proxy_authkey }}
{% endif %}
{% if tailscale_proxy_federated_client_id | default('') | length > 0 %}
TS_FEDERATED_CLIENT_ID={{ tailscale_proxy_federated_client_id }}
{% endif %}
{% if tailscale_proxy_federated_audience | default('') | length > 0 %}
TS_FEDERATED_AUDIENCE={{ tailscale_proxy_federated_audience }}
{% endif %}
{% if tailscale_proxy_control_url is defined %}
TS_CONTROL_URL={{ tailscale_proxy_control_url }}
{% endif %}
